local npcCache = { list = {}, lastUpdate = 0 }
local function collectNPCs()
   local now = tick()
   if now - npcCache.lastUpdate < 0.5 then return npcCache.list end
   local npcs = {}
   local myChar = LocalPlayer.Character
   local function scan(container, depth)
      if depth > 6 then return end
      local ok, children = pcall(function() return container:GetChildren() end)
      if not ok then return end
      for _, obj in ipairs(children) do
         if obj:IsA("Model") then
            local hum = obj:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 and not Players:GetPlayerFromCharacter(obj) and obj ~= myChar then
               npcs[#npcs+1] = obj
            end
         end
         if obj ~= Players and obj ~= myChar then pcall(scan, obj, depth + 1) end
      end
   end
   scan(Workspace, 0)
   npcCache.list = npcs
   npcCache.lastUpdate = now
   return npcs
end

