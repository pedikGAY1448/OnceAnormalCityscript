-- КЕШ: ищем ammo/jammed/zero ОДИН РАЗ при смене оружия
-- ============================================================
local ToolCache = {}

-- Поиск источника ammo (Attributes → Tool → Character → Backpack)
local function findAmmoSource(tool)
   if not tool then return nil end
   local attrs = { "ACSClientAmmoInGun", "AmmoInGun", "CurrentAmmo", "ClipAmmo",
      "MagAmmo", "Ammo", "AmmoCount", "BulletsInGun", "RoundsInGun",
      "BulletsLeft", "RoundsLeft", "ShellsInGun" }
   for _, attr in ipairs(attrs) do
      local ok, val = pcall(function() return tool:GetAttribute(attr) end)
      if ok and val ~= nil and type(val) == "number" then return "attr", attr end
   end
   for _, d in ipairs(tool:GetDescendants()) do
      if (d:IsA("IntValue") or d:IsA("NumberValue")) and isAmmoName(d.Name) then return "inst", d end
   end
   if LocalPlayer.Character then
      for _, d in ipairs(LocalPlayer.Character:GetDescendants()) do
         if (d:IsA("IntValue") or d:IsA("NumberValue")) and isAmmoName(d.Name) then return "inst", d end
      end
   end
   local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
   if backpack then
      for _, d in ipairs(backpack:GetDescendants()) do
         if (d:IsA("IntValue") or d:IsA("NumberValue")) and isAmmoName(d.Name) then return "inst", d end
      end
   end
   return nil
end

-- Поиск источника jammed
local function findJammedSource(tool)
   if not tool then return nil end
   local attrs = { "ACSClientJammed", "Jammed", "IsJammed", "JammedState", "IsJam", "GunJammed", "WeaponJammed" }
   for _, attr in ipairs(attrs) do
      local ok, val = pcall(function() return tool:GetAttribute(attr) end)
      if ok and val ~= nil then return "attr", attr end
   end
   local function scan(root)
      if not root then return nil end
      for _, d in ipairs(root:GetDescendants()) do
         if isJammedName(d.Name) then return d end
      end
      return nil
   end
   local found = scan(tool) or scan(LocalPlayer.Character)
   if found then return "inst", found end
   local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
   if backpack then
      local f = scan(backpack)
      if f then return "inst", f end
   end
   return nil
end

-- Собираем кеш для Tool (один раз при смене)
local function buildToolCache(tool)
   if not tool then return nil end
   local cache = { AmmoInst=nil, AmmoAttr=nil, JammedInst=nil, JammedAttr=nil,
      ZeroInstances={}, ZeroPaths={}, Settings=nil }
   local ammoType, ammoRef = findAmmoSource(tool)
   if ammoType == "attr" then cache.AmmoAttr = ammoRef
   elseif ammoType == "inst" then cache.AmmoInst = ammoRef end
   local jamType, jamRef = findJammedSource(tool)
   if jamType == "attr" then cache.JammedAttr = jamRef
   elseif jamType == "inst" then cache.JammedInst = jamRef end
   local function collectZero(root)
      if not root then return end
      for _, d in ipairs(root:GetDescendants()) do
         if (d:IsA("IntValue") or d:IsA("NumberValue")) and isZeroName(d.Name) then
            cache.ZeroInstances[d] = d.Value
         end
      end
   end
   collectZero(tool)
   collectZero(LocalPlayer.Character)
   local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
   if backpack then collectZero(backpack) end
   local settings = getOrCreateSettings(tool)
   if settings then
      cache.Settings = settings
      for _, path in ipairs(ZERO_RECOIL_PATHS_STATIC) do
         local val, ok = getByPath(settings, path)
         if ok then cache.ZeroPaths[path] = val end
      end
   end
   ToolCache[tool] = cache
   return cache
end

-- Читаем ammo из кеша (мгновенно)
local function getAmmoInGun(tool)
   if not tool then return 0, false, nil end
   local cache = ToolCache[tool]
   if not cache then cache = buildToolCache(tool) end
   if not cache then return 0, false, nil end
   if cache.AmmoAttr then
      local ok, val = pcall(function() return tool:GetAttribute(cache.AmmoAttr) end)
      if ok and type(val) == "number" then return val, true, "attr:" .. cache.AmmoAttr end
   end
   if cache.AmmoInst and cache.AmmoInst.Parent then
      return cache.AmmoInst.Value, true, "val:" .. cache.AmmoInst.Name
   end
   return 0, false, nil
end

-- Читаем jammed из кеша
local function getJammed(tool)
   if not tool then return false end
   local cache = ToolCache[tool]
   if not cache then cache = buildToolCache(tool) end
   if not cache then return false end
   if cache.JammedAttr then
      local ok, val = pcall(function() return tool:GetAttribute(cache.JammedAttr) end)
      if ok and val ~= nil then
         if type(val) == "boolean" then return val end
         if type(val) == "number" then return val ~= 0 end
      end
   end
   if cache.JammedInst and cache.JammedInst.Parent then
      local v = cache.JammedInst.Value
      if typeof(v) == "boolean" then return v end
      if typeof(v) == "number" then return v ~= 0 end
   end
   return false
end

-- Проверка можно ли стрелять
local function canShoot(tool)
   if not tool then return false end
   if SETTINGS.CheckJammed and getJammed(tool) then return false end
   if SETTINGS.CheckAmmo then
      local ammo, hasData = getAmmoInGun(tool)
      if hasData and ammo <= 0 then return false end
   end
   return true
end

-- Обнуляем recoil/spread
local function zeroStats(tool)
   if not tool then return end
   local cache = ToolCache[tool]
   if not cache then cache = buildToolCache(tool) end
   if not cache then return end
   for inst, _ in pairs(cache.ZeroInstances) do
      if inst and inst.Parent then pcall(function() inst.Value = 0 end) end
   end
   if cache.Settings then
      for path, _ in pairs(cache.ZeroPaths) do setByPathSafe(cache.Settings, path, 0) end
   end
end

-- Восстанавливаем оригинальные значения
local function restoreOriginalStats(tool)
   if not tool then return end
   local cache = ToolCache[tool]
   if not cache then return end
   for inst, val in pairs(cache.ZeroInstances) do
      if inst and inst.Parent then pcall(function() inst.Value = val end) end
   end
   if cache.Settings then
      for path, val in pairs(cache.ZeroPaths) do setByPathSafe(cache.Settings, path, val) end
   end
   ToolCache[tool] = nil
end

local function restoreAllStats()
   for tool in pairs(ToolCache) do restoreOriginalStats(tool) end
end

local function saveOriginalStats(tool)
   if tool and not ToolCache[tool] then buildToolCache(tool) end
end

