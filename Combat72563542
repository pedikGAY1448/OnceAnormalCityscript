local fovFrame = Instance.new("Frame")
fovFrame.AnchorPoint = Vector2.new(0.5, 0.5)
fovFrame.BackgroundTransparency = 1
fovFrame.Visible = false
fovFrame.Parent = fovGui

local fovCircleParts = {}
local function createCircle(parent, radius)
   local segments = 64
   for i = 1, segments do
      local part = Instance.new("Frame")
      part.Size = UDim2.new(0, math.max(2, math.ceil(math.pi * 2 * radius / segments)), 0, 1)
      part.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
      part.BorderSizePixel = 0
      part.AnchorPoint = Vector2.new(0.5, 0.5)
      part.Position = UDim2.new(0.5, 0, 0.5, 0)
      part.Rotation = (i / segments) * 360
      part.Parent = parent
      table.insert(fovCircleParts, { part = part, radius = radius, angle = (i / segments) * 360 })
   end
end

local function updateCircle(radius)
   local segments = #fovCircleParts
   if segments == 0 then return end
   local segSize = math.max(2, math.ceil(math.pi * 2 * radius / segments))
   for _, data in ipairs(fovCircleParts) do
      local part = data.part
      part.Size = UDim2.new(0, segSize, 0, 1)
      local rad = math.rad(data.angle)
      local x = math.cos(rad) * radius
      local y = math.sin(rad) * radius
      part.Position = UDim2.new(0.5, x, 0.5, y)
      part.Rotation = data.angle
   end
end

createCircle(fovFrame, 300)

