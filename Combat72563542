-- ============================================================
-- ЦИКЛЫ SILENT AIM и ZERO RECOIL
-- ============================================================
task.spawn(function()
   while not Unloaded do
      local speed = math.max(0.1, SETTINGS.LoopSpeedMult)
      if SETTINGS.Enabled and not Firing and isAimHeld() then
         local target = findTargetV16()
         if target and isAlive(target.Parent) then
            snapFireRestore(target)
            local cd
            local untilDeath = false
            if SETTINGS.RepeatMode == "Time" then
               if SETTINGS.FixedTimeDelay <= 0 then
                  untilDeath = true
                  cd = 0
               else
                  cd = SETTINGS.FixedTimeDelay / speed
               end
            else
               local rpm = 600
               local t = getEquippedTool()
               if t then
                  local mod = t:FindFirstChild("ACS_Settings")
                  if mod then
                     local ok, settings = pcall(require, mod)
                     if ok and type(settings) == "table" then
                        rpm = settings.ShootRate or settings.FireRate or settings.RPM or 600
                     end
                  end
               end
               cd = ((60 / rpm) * SETTINGS.CooldownMult) / speed
            end
            if untilDeath then
               while isAlive(target.Parent) and not Unloaded do task.wait(0.02) end
            else
               local t = 0
               while t < cd and not Unloaded do
                  task.wait(0.02); t = t + 0.02
                  if not isAlive(target.Parent) then break end
               end
            end
         else
            task.wait(0.1 / speed)
         end
      else
         task.wait(0.1 / speed)
      end
   end
end)

