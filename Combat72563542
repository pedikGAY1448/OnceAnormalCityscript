-- ЦИКЛ CF RAME / MOUSE
-- ============================================================
addConn(RunService.RenderStepped:Connect(function()
   if Unloaded then return end
   local cam = Workspace.CurrentCamera
   if not cam then return end
   if State.Cframe.Enabled then
      local best = findBestTarget(State.Cframe, State.Targets, State.TargetPart, State.WallCheck)
      if best then
         local targetPos = getPredictedPositionFor(best, State.PredictMode, State.PredictCustom)
         local current = cam.CFrame
         local desired = CFrame.new(current.Position, targetPos)
         local alpha = math.clamp(State.Cframe.Speed / 100, 0.001, 1)
         cam.CFrame = current:Lerp(desired, alpha)
      end
   else State.Cframe.Locked = nil end
   if State.Mouse.Enabled then
      local best = findBestTarget(State.Mouse, State.Targets, State.TargetPart, State.WallCheck)
      if best then
         local targetPos = getPredictedPositionFor(best, State.PredictMode, State.PredictCustom)
         local screenPoint, onScreen = cam:WorldToViewportPoint(targetPos)
         if onScreen then
            local center = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
            local delta = Vector2.new(screenPoint.X, screenPoint.Y) - center
            local factor = math.clamp(State.Mouse.Speed / 50, 0.001, 1)
            local move = delta * factor
            if mousemoverel then mousemoverel(move.X, move.Y)
            elseif mousemoveabs then mousemoveabs(center.X + move.X, center.Y + move.Y) end
         end
      end
   else State.Mouse.Locked = nil end
end))

