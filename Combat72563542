end

-- ============================================================
-- SNAP FIRE RESTORE (Silent Aim)
-- ============================================================
local Firing = false
local originalCF = nil

local function snapFireRestore(targetPart)
   if Firing then return end
   Firing = true
   local ok, err = pcall(function()
      if not isAlive(targetPart.Parent) then return end
      local tool = getEquippedTool()
      if not tool then return end
      if not canShoot(tool) then return end
      if SETTINGS.BlockMouse then blockMouse() end
      originalCF = Camera.CFrame
      -- ФАЗА 1: SNAP — держим камеру на цели
      local elapsed = 0
      while elapsed < SETTINGS.SnapDelay and not Unloaded do
         if not isAlive(targetPart.Parent) then break end
         Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, targetPart.Position)
         task.wait(0.01)
         elapsed = elapsed + 0.01
      end
      if not isAlive(targetPart.Parent) then
         Camera.CFrame = originalCF; originalCF = nil
         if SETTINGS.BlockMouse then unblockMouse() end
         return
      end
      tool = getEquippedTool()
      if not canShoot(tool) then
         Camera.CFrame = originalCF; originalCF = nil
         if SETTINGS.BlockMouse then unblockMouse() end
         return
      end
      -- ФАЗА 2: КЛИКИ
      for i = 1, SETTINGS.ClicksCount do
         if Unloaded or not isAlive(targetPart.Parent) then break end
         Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, targetPart.Position)
         task.wait(SETTINGS.ClickInterval)
         if Unloaded or not isAlive(targetPart.Parent) then break end
         Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, targetPart.Position)
         if SETTINGS.AutoFire then mouseClickV16() end
      end
      -- ФАЗА 3: HOLD AFTER SHOT
      local holdTime = math.max(0.001, SETTINGS.HoldAfterShot)
      local held = 0
      while held < holdTime and not Unloaded do
         if not isAlive(targetPart.Parent) then break end
         Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, targetPart.Position)
         task.wait(0.001)
         held = held + 0.001
      end
      -- Возврат камеры
      if originalCF then Camera.CFrame = originalCF; originalCF = nil end
      if SETTINGS.BlockMouse then unblockMouse() end
      -- Zero Recoil после выстрела
      if SETTINGS.ZeroRecoil or SETTINGS.ZeroSpread then
         local t = getEquippedTool()
         if t then zeroStats(t) end
      end
   end)
   if not ok then
      if originalCF then pcall(function() Camera.CFrame = originalCF end) originalCF = nil end
      if SETTINGS.BlockMouse then unblockMouse() end
   end
   Firing = false
end

