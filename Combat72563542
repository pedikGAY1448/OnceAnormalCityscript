   if mouseBlocked then return end
   mouseBlocked = true
   originalMouseBehavior = UserInputService.MouseBehavior
   pcall(function() UserInputService.MouseBehavior = Enum.MouseBehavior.LockCurrentPosition end)
   pcall(function()
