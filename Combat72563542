-- Нормализация имени (нижний регистр + убрать пробелы/подчёркивания/дефисы)
local function normalizeName(s) return tostring(s):lower():gsub("[%s_%-]", "") end

-- Проверки по именам
local function isAmmoName(name)
   local n = normalizeName(name)
   if AMMO_STOP_SET[n] then return false end
   return AMMO_PATTERN_SET[n] == true
end
local function isJammedName(name)
   local n = normalizeName(name)
   if JAMMED_STOP_SET[n] then return false end
   return JAMMED_SET[n] == true
end
local function isZeroName(name)
   local n = normalizeName(name)
   return ZERO_SET[n] == true
end

