-- ============================================================
-- ХЕЛПЕРЫ: получить часть тела у персонажа
-- ============================================================
local function getPartFromCharacter(char, partType)
   if not char or not char.Parent then return nil end
   local head = char:FindFirstChild("Head")
   local torso = char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
      or char:FindFirstChild("LowerTorso") or char:FindFirstChild("HumanoidRootPart")
   if partType == "Head" then return head end
   if partType == "Torso" then return torso end
   return char:FindFirstChild("HumanoidRootPart") or torso or head -- Center
end

-- Проверка: NPC с Humanoid + HumanoidRootPart + Head + Torso
local function isNpcHumanoid(model)
   if not model:FindFirstChildOfClass("Humanoid") then return false end
   if not model:FindFirstChild("HumanoidRootPart") then return false end
   if not model:FindFirstChild("Head") then return false end
   local torso = model:FindFirstChild("Torso") or model:FindFirstChild("UpperTorso") or model:FindFirstChild("LowerTorso")
   return torso ~= nil
end

-- Собрать список целей (для Cframe / Mouse)
local function collectTargets(targetsCfg)
   if Unloaded then return {} end
   local list = {}
   local T = targetsCfg or State.Targets

   -- Игроки
   if T.Player then
      for _, plr in ipairs(Players:GetPlayers()) do
         if plr ~= LocalPlayer and plr.Character then
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then table.insert(list, plr.Character) end
         end
      end
   end
   -- NPC по Humanoid
   if T.Npc_Humanoid then
      for _, d in ipairs(Workspace:GetDescendants()) do
         if d:IsA("Model") and isNpcHumanoid(d) and not Players:GetPlayerFromCharacter(d) then
            local hum = d:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then table.insert(list, d) end
         end
      end
   end
   -- NPC в папках (Npc_Workspace)
   if T.Npc_Workspace then
      local folders = {"NPCs", "Npcs", "npcs", "Enemies", "Mobs", "Monsters", "Bots"}
      for _, name in ipairs(folders) do
         local folder = Workspace:FindFirstChild(name, true)
         if folder then
            for _, d in ipairs(folder:GetDescendants()) do
               if d:IsA("Model") and d:FindFirstChild("HumanoidRootPart") then table.insert(list, d) end
            end
         end
      end
   end
   return list
end

-- Проверка линии видимости (WallCheck для Cframe / Mouse)
local function hasLineOfSightFor(fromPos, toPart, wallCheckFlag)
   if not wallCheckFlag then return true end
   local params = RaycastParams.new()
   params.FilterType = Enum.RaycastFilterType.Exclude
   params.FilterDescendantsInstances = { LocalPlayer.Character, toPart.Parent }
   params.IgnoreWater = true
   local result = Workspace:Raycast(fromPos, toPart.Position - fromPos, params)
   return result == nil
end

-- Предсказание позиции с учётом скорости цели
local function getPredictedPositionFor(part, predictMode, predictCustom)
   if not part then return nil end
   local pos = part.Position
   local velocity = part.AssemblyLinearVelocity or Vector3.zero
   local ms = (predictMode == "Custom") and predictCustom or math.clamp(velocity.Magnitude * 4, 0, 200)
   return pos + velocity * (ms / 1000)
end

-- Проверка, что залоченная цель жива
local function isLockedValidFor(part, wallCheck)
   if not part or not part.Parent then return false end
   local char = part.Parent
   local hum = char:FindFirstChildOfClass("Humanoid")
   if hum and hum.Health <= 0 then return false end
   local cam = Workspace.CurrentCamera
   if not cam then return false end
   if not hasLineOfSightFor(cam.CFrame.Position, part, wallCheck) then return false end
   local _, onScreen = cam:WorldToViewportPoint(part.Position)
   if not onScreen then return false end
   local dist = (part.Position - cam.CFrame.Position).Magnitude
   return dist <= 1000
end

-- Поиск лучшей цели (ближайшей к центру экрана) для Cframe / Mouse
local function findBestTarget(modeState, targetsCfg, targetPart, wallCheck)
   if Unloaded then return nil end
   if modeState.LoopTarget and modeState.Locked then
      if isLockedValidFor(modeState.Locked, wallCheck) then return modeState.Locked
      else modeState.Locked = nil end
   end
   local cam = Workspace.CurrentCamera
   if not cam then return nil end
   local targets = collectTargets(targetsCfg)
   if #targets == 0 then return nil end
   local tp = targetPart or State.TargetPart
   local best, bestDist = nil, math.huge
   local myPos = cam.CFrame.Position
   local center = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
   for _, char in ipairs(targets) do
      local part = getPartFromCharacter(char, tp)
      if part and hasLineOfSightFor(myPos, part, wallCheck) then
         local screenPoint, onScreen = cam:WorldToViewportPoint(part.Position)
         if onScreen then
            local d = (Vector2.new(screenPoint.X, screenPoint.Y) - center).Magnitude
            if d < bestDist then bestDist = d; best = part end
         end
      end
   end
   if best and modeState.LoopTarget then modeState.Locked = best end
   return best
end

