local function getMuzzlePosition(tool)
   if not tool then return nil end
   local candidates = { "Muzzle", "muzzle", "MuzzlePoint", "muzzlePoint", "BarrelPoint", "Tip", "tip" }
   for _, name in ipairs(candidates) do
