addConn(RunService.RenderStepped:Connect(function()
   if Unloaded then return end
   local show = SETTINGS.Enabled and SETTINGS.ShowFOV
   fovFrame.Visible = show
   if show then
      local mouse = UserInputService:GetMouseLocation()
      fovFrame.Position = UDim2.fromOffset(mouse.X, mouse.Y)
      updateFOVCircle(SETTINGS.FOV)
   end
   if mouseBlocked and typeof(mousemoverel) == "function" then
      pcall(function() mousemoverel(0, 0) end)
   end
end))

addConn(RunService.RenderStepped:Connect(function()
   if Unloaded then return end
   local cam = Workspace.CurrentCamera
   if not cam then return end
   if State.Cframe.Enabled then
      local best = findBestTarget(State.Cframe, State.Targets, State.TargetPart, State.WallCheck)
      if best then
         local targetPos = getPredictedPositionFor(best, State.PredictMode, State.PredictCustom)
         local current = cam.CFrame
         local desired = CFrame.new(current.Position, targetPos)
         local alpha = math.clamp(State.Cframe.Speed / 100, 0.001, 1)
         cam.CFrame = current:Lerp(desired, alpha)
      end
   else State.Cframe.Locked = nil end
   if State.Mouse.Enabled then
      local best = findBestTarget(State.Mouse, State.Targets, State.TargetPart, State.WallCheck)
      if best then
         local targetPos = getPredictedPositionFor(best, State.PredictMode, State.PredictCustom)
         local screenPoint, onScreen = cam:WorldToViewportPoint(targetPos)
         if onScreen then
            local center = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
            local delta = Vector2.new(screenPoint.X, screenPoint.Y) - center
            local factor = math.clamp(State.Mouse.Speed / 50, 0.001, 1)
            local move = delta * factor
            if mousemoverel then mousemoverel(move.X, move.Y)
            elseif mousemoveabs then mousemoveabs(center.X + move.X, center.Y + move.Y) end
         end
      end
   else State.Mouse.Locked = nil end
end))

task.spawn(function()
   while not Unloaded do
      task.wait(0.5)
      pcall(function()
         if lastTarget then
            diagTarget:Set({ Title = "Target", Content = (lastTarget.Parent and lastTarget.Parent.Name or "?") .. " → " .. lastTarget.Name })
         else diagTarget:Set({ Title = "Target", Content = "—" }) end
         diagWall:Set({ Title = "Wall", Content = lastWallInfo ~= "" and lastWallInfo or "—" })
         local tool = getEquippedTool()
         if tool then
            local ammo, hasData, src = getAmmoInGun(tool)
            diagAmmo:Set({ Title = "Ammo", Content = hasData and (tostring(ammo) .. " (" .. tostring(src) .. ")") or "—" })
            local jam = getJammed(tool)
            diagJammed:Set({ Title = "Jammed", Content = tostring(jam) })
            local wbPower, wbKey = getWallbangPower(tool)
            diagWB:Set({ Title = "Wallbang", Content = string.format("%.1f studs (%s)", wbPower, tostring(wbKey)) })
         else
            diagAmmo:Set({ Title = "Ammo", Content = "—" })
            diagJammed:Set({ Title = "Jammed", Content = "—" })
            diagWB:Set({ Title = "Wallbang", Content = "—" })
         end
         diagNPC:Set({ Title = "NPC", Content = tostring(#collectNPCs()) })
         diagMouse:Set({ Title = "Mouse", Content = mouseBlocked and "LOCKED" or "free" })
         diagAim:Set({ Title = "Aim Check", Content = SETTINGS.AimCheckEnabled and (isAimHeld() and "HELD ✅" or "NOT HELD ❌") or "disabled" })
         diagTrigger:Set({ Title = "Trigger Bot", Content = SETTINGS.TriggerEnabled and "ENABLED" or "disabled" })
         local count = 0
         for _ in pairs(ToolCache) do count = count + 1 end
         diagCache:Set({ Title = "Cached Tools", Content = tostring(count) })
         if WBInfo and WBInfo.Set then
            local tool = getEquippedTool()
            if tool then
               local wbPower, wbKey = getWallbangPower(tool)
               WBInfo:Set({
                  Title = "Status",
                  Content = string.format("Power: %.1f studs\nSource: %s\nMax 1 wall: %.1f",
                     wbPower, tostring(wbKey), SETTINGS.MaxWallThickness)
               })
            else WBInfo:Set({ Title = "Status", Content = "No tool equipped" }) end
         end
      end)
   end
end)

