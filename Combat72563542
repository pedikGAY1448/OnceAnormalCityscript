local function getMuzzlePosition(tool)
   if not tool then return nil end
   local candidates = { "Muzzle", "muzzle", "MuzzlePoint", "muzzlePoint", "BarrelPoint", "Tip", "tip" }
   for _, name in ipairs(candidates) do
      local found = tool:FindFirstChild(name, true)
      if found and found:IsA("Attachment") then return found.WorldPosition end
   end
   local partNames = { "Muzzle", "muzzle", "Barrel", "barrel", "Tip", "tip", "MuzzlePoint" }
   for _, name in ipairs(partNames) do
      local found = tool:FindFirstChild(name, true)
      if found and found:IsA("BasePart") then return found.Position end
   end
   local handle = tool:FindFirstChild("Handle")
   if handle and handle:IsA("BasePart") then return handle.Position + handle.CFrame.LookVector * 1.5 end
   return nil
end

