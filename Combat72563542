   local char = LocalPlayer.Character
   if not char then return nil end
   return char:FindFirstChildOfClass("Tool")
end

local function measureWallThickness(enterPos, direction, hitPart, targetParent)
   local insideOrigin = enterPos + direction.Unit * 0.05
   local insideParams = RaycastParams.new()
   insideParams.FilterType = Enum.RaycastFilterType.Exclude
   local filterList = { LocalPlayer.Character, targetParent }
   if hitPart then table.insert(filterList, hitPart) end
   insideParams.FilterDescendantsInstances = filterList
   insideParams.IgnoreWater = true
   local exitResult = Workspace:Raycast(insideOrigin, direction.Unit * 50, insideParams)
   if not exitResult then return 50 end
   return (exitResult.Position - enterPos).Magnitude
end

local function measureTotalWalls(myRoot, targetPart)
   local params = RaycastParams.new()
   params.FilterType = Enum.RaycastFilterType.Exclude
   params.FilterDescendantsInstances = { LocalPlayer.Character, targetPart.Parent }
   params.IgnoreWater = true
   local origin = myRoot.Position
   if SETTINGS.WallOriginMode == "muzzle" then
      local tool = getEquippedTool()
      local muzzlePos = tool and getMuzzlePosition(tool) or nil
      if muzzlePos then origin = muzzlePos end
   elseif SETTINGS.WallOriginMode == "camera" then
      origin = Camera.CFrame.Position
   end
   local direction = targetPart.Position - origin
   local totalThickness, tooThick, maxSingle, lastHitInstance = 0, false, 0, nil
   for i = 1, 32 do
      local result = Workspace:Raycast(origin, direction, params)
      if not result then break end
      if result.Instance and result.Instance:IsDescendantOf(targetPart.Parent) then break end
      local hitModel = result.Instance and result.Instance:FindFirstAncestorOfClass("Model")
      if hitModel and hitModel == targetPart.Parent then break end
      local hitPart = result.Instance
      if hitPart == lastHitInstance then
         local skipOrigin = result.Position + direction.Unit * 0.5
         direction = targetPart.Position - skipOrigin
         if direction.Magnitude < 0.1 then break end
         origin = skipOrigin
         continue
      end
      lastHitInstance = hitPart
      local thickness = measureWallThickness(result.Position, direction, hitPart, targetPart.Parent)
      if thickness > maxSingle then maxSingle = thickness end
      if thickness > SETTINGS.MaxWallThickness then tooThick = true; return totalThickness, true, maxSingle end
      totalThickness = totalThickness + thickness
      local step = thickness + 0.2
      local newOrigin = result.Position + direction.Unit * step
      newOrigin = newOrigin + result.Normal * 0.05
      direction = targetPart.Position - newOrigin
      if direction.Magnitude < 0.1 then break end
      origin = newOrigin
   end
   return totalThickness, tooThick, maxSingle
end

local lastTarget, lastReason, lastWallInfo = nil, "", ""

local function getWallbangPower(tool)
   if SETTINGS.WallbangOverride then return SETTINGS.WallbangOverrideVal, "override" end
   local settings = getOrCreateSettings(tool)
   if not settings then return 0, "0" end
   local function deepSearch(tbl, depth)
      if depth > 4 or type(tbl) ~= "table" then return nil, nil end
      for k, v in pairs(tbl) do
         if type(k) == "string" then
            local nk = normalizeName(k)
            if not nk:find("bulletpen") then
               if type(v) == "number" and (nk:find("wallbang") or nk == "penetration"
                  or nk == "penetrationpower" or nk == "wallpenetration"
                  or nk == "penetrationamount" or nk == "penetrationdepth") then
                  return v, k
               end
            end
         end
         if type(v) == "table" then
            local f, fk = deepSearch(v, depth + 1)
            if f then return f, fk end
         end
      end
      return nil, nil
   end
   local val, key = deepSearch(settings, 0)
   if type(val) ~= "number" then val = 0 end
   return val * SETTINGS.WallbangMult, (key or "0")
end

local function canHitTarget(targetPart)
   if not SETTINGS.WallCheck then return true, 0, "wallcheck_off" end
   local myChar = LocalPlayer.Character
   if not myChar then return false, 0, "no_char" end
   local myRoot = myChar:FindFirstChild("HumanoidRootPart") or myChar:FindFirstChild("Head")
   if not myRoot then return false, 0, "no_root" end
   local totalThickness, tooThick, maxSingle = measureTotalWalls(myRoot, targetPart)
   if tooThick then
      return false, totalThickness, "too_thick_wall (single=" .. string.format("%.1f", maxSingle) .. ")"
   end
   if totalThickness <= 0.01 then return true, 0, "clear" end
   local char = LocalPlayer.Character
   local tool = char and char:FindFirstChildOfClass("Tool") or nil
   local wbPower = getWallbangPower(tool)
   if wbPower <= 0 then return false, totalThickness, "no_wallbang" end
   if totalThickness <= wbPower then
      return true, totalThickness, "wb_ok (thick=" .. string.format("%.1f", totalThickness) .. " ≤ " .. string.format("%.1f", wbPower) .. ")"
   end
   return false, totalThickness, "too_thick"
end

local function findTargetV16()
   local best, bestDist = nil, SETTINGS.FOV
   local mousePos = UserInputService:GetMouseLocation()
   local myChar = LocalPlayer.Character
   if not myChar then return nil end
   local myRoot = myChar:FindFirstChild("HumanoidRootPart") or myChar:FindFirstChild("Head")
   if not myRoot then return nil end
   local candidates = {}
   if SETTINGS.TargetNPCs then
      for _, npc in ipairs(collectNPCs()) do candidates[#candidates+1] = npc end
   end
   if SETTINGS.TargetPlayers then
      for _, plr in ipairs(Players:GetPlayers()) do
         if plr ~= LocalPlayer and plr.Character and plr.Character ~= myChar then
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
               if SETTINGS.TeamCheck and plr.Team and LocalPlayer.Team and plr.Team == LocalPlayer.Team then continue end
               candidates[#candidates+1] = plr.Character
            end
         end
      end
   end
   local bestBlockReason = ""
   for _, model in ipairs(candidates) do
      if isAlive(model) then
         local part = getTargetPartV16(model)
         if part then
            local dist = (part.Position - myRoot.Position).Magnitude
            if dist <= SETTINGS.MaxDistance then
               local screenPos, onScreen = Camera:WorldToViewportPoint(part.Position)
               if onScreen then
                  local screenDist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                  if screenDist < bestDist then
                     local canHit, _, reason = canHitTarget(part)
                     if canHit then
                        bestDist = screenDist
                        best = part
                        lastReason = reason
                     else
                        bestBlockReason = reason
                     end
                  end
               end
            end
         end
      end
   end
   lastTarget = best
   if not best and bestBlockReason ~= "" then lastWallInfo = "BLOCKED: " .. bestBlockReason
   else lastWallInfo = lastReason end
   return best
end

local function mouseClickV16()
   if typeof(mouse1click) == "function" then mouse1click(); return end
   if typeof(mouse1press) == "function" and typeof(mouse1release) == "function" then
      mouse1press(); task.wait(0.01); mouse1release(); return
   end
   local VIM = game:GetService("VirtualInputManager")
   local loc = UserInputService:GetMouseLocation()
   pcall(function() VIM:SendMouseButtonEvent(loc.X, loc.Y, 0, true, game, 1) end)
   task.wait(0.01)
   pcall(function() VIM:SendMouseButtonEvent(loc.X, loc.Y, 0, false, game, 1) end)
end

local Firing = false
local originalCF = nil

local function snapFireRestore(targetPart)
   if Firing then return end
   Firing = true
   local ok, err = pcall(function()
      if not isAlive(targetPart.Parent) then return end
      local tool = getEquippedTool()
      if not tool then return end
      if not canShoot(tool) then return end

      if SETTINGS.CheckCanHit then
         local canHit, _, reason = canHitTarget(targetPart)
         if not canHit then
            lastWallInfo = "CAN-HIT BLOCKED: " .. tostring(reason)
            return
         end
      end

      local speed = math.max(0.1, SETTINGS.LoopSpeedMult)

      if SETTINGS.BlockMouse then blockMouse() end
      originalCF = Camera.CFrame

      local snapDelay = SETTINGS.SnapDelay / speed
      local snapStart = tick()
      while (tick() - snapStart) < snapDelay and not Unloaded do
         if not isAlive(targetPart.Parent) then break end
         Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, targetPart.Position)
         RunService.RenderStepped:Wait()
      end

      if not isAlive(targetPart.Parent) then
         Camera.CFrame = originalCF; originalCF = nil
         if SETTINGS.BlockMouse then unblockMouse() end
         return
      end
      tool = getEquippedTool()
      if not canShoot(tool) then
         Camera.CFrame = originalCF; originalCF = nil
         if SETTINGS.BlockMouse then unblockMouse() end
         return
      end

      for i = 1, SETTINGS.ClicksCount do
         if Unloaded or not isAlive(targetPart.Parent) then break end
         Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, targetPart.Position)
         if SETTINGS.ClickInterval > 0 then
            local clickStart = tick()
            while (tick() - clickStart) < SETTINGS.ClickInterval and not Unloaded do
               if not isAlive(targetPart.Parent) then break end
               Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, targetPart.Position)
               RunService.RenderStepped:Wait()
            end
         end
         if Unloaded or not isAlive(targetPart.Parent) then break end
         Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, targetPart.Position)
         if SETTINGS.AutoFire then mouseClickV16() end
      end

      if SETTINGS.HoldAfterShot > 0 then
         local holdDelay = SETTINGS.HoldAfterShot / speed
         local holdStart = tick()
         while (tick() - holdStart) < holdDelay and not Unloaded do
            if not isAlive(targetPart.Parent) then break end
            Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, targetPart.Position)
            RunService.RenderStepped:Wait()
         end
      end

      if originalCF then Camera.CFrame = originalCF; originalCF = nil end
      if SETTINGS.BlockMouse then unblockMouse() end
      if SETTINGS.ZeroRecoil or SETTINGS.ZeroSpread then
         local t = getEquippedTool()
         if t then zeroStats(t) end
      end
   end)
   if not ok then
      if originalCF then pcall(function() Camera.CFrame = originalCF end) originalCF = nil end
      if SETTINGS.BlockMouse then unblockMouse() end
   end
   Firing = false
end

local function isCrosshairOnTarget()
   local cam = Workspace.CurrentCamera
   if not cam then return false end
   local mousePos = UserInputService:GetMouseLocation()
   local myChar = LocalPlayer.Character
   if not myChar then return false end
   local myRoot = myChar:FindFirstChild("HumanoidRootPart") or myChar:FindFirstChild("Head")
   if not myRoot then return false end
   local candidates = {}
   if SETTINGS.TargetNPCs then
      for _, npc in ipairs(collectNPCs()) do candidates[#candidates+1] = npc end
   end
   if SETTINGS.TargetPlayers then
      for _, plr in ipairs(Players:GetPlayers()) do
         if plr ~= LocalPlayer and plr.Character and plr.Character ~= myChar then
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
               if SETTINGS.TeamCheck and plr.Team and LocalPlayer.Team and plr.Team == LocalPlayer.Team then continue end
               candidates[#candidates+1] = plr.Character
            end
         end
      end
   end
   local partsToCheck = {}
   if SETTINGS.TriggerTargets.All then
      partsToCheck = {"Head", "Torso", "Center"}
   else
      if SETTINGS.TriggerTargets.Head then table.insert(partsToCheck, "Head") end
      if SETTINGS.TriggerTargets.Torso then table.insert(partsToCheck, "Torso") end
   end
   if #partsToCheck == 0 then return false end
   for _, model in ipairs(candidates) do
      if isAlive(model) then
         for _, pType in ipairs(partsToCheck) do
            local part = getPartFromCharacter(model, pType)
            if part then
               local dist = (part.Position - myRoot.Position).Magnitude
               if dist <= SETTINGS.MaxDistance then
                  local screenPos, onScreen = cam:WorldToViewportPoint(part.Position)
                  if onScreen then
                     local screenDist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                     if screenDist < 30 then
                        if SETTINGS.TriggerWallCheck then
                           if not hasLineOfSightFor(myRoot.Position, part, true) then continue end
                        end
                        return true, part
                     end
                  end
               end
            end
         end
      end
   end
   return false, nil
end

task.spawn(function()
   while not Unloaded do
      task.wait(0.01)
      if not SETTINGS.TriggerEnabled then task.wait(0.1); continue end
      if not isAimHeld() then task.wait(0.05); continue end
      local tool = getEquippedTool()
      if tool and not canShoot(tool) then task.wait(0.05); continue end
      local onTarget = isCrosshairOnTarget()
      if onTarget then
         if SETTINGS.TriggerHoldBefore > 0 then
            local tStart = tick()
            while (tick() - tStart) < SETTINGS.TriggerHoldBefore and not Unloaded do
               RunService.RenderStepped:Wait()
            end
         end
         if Unloaded then break end
         local still = isCrosshairOnTarget()
         if still then
            if typeof(mouse1click) == "function" then mouse1click()
            elseif typeof(mouse1press) == "function" and typeof(mouse1release) == "function" then
               mouse1press(); task.wait(0.01); mouse1release()
            else
               local VIM = game:GetService("VirtualInputManager")
               local loc = UserInputService:GetMouseLocation()
               pcall(function() VIM:SendMouseButtonEvent(loc.X, loc.Y, 0, true, game, 1) end)
               task.wait(0.01)
               pcall(function() VIM:SendMouseButtonEvent(loc.X, loc.Y, 0, false, game, 1) end)
            end
            task.wait(SETTINGS.TriggerCooldown)
         end
      else
         task.wait(0.02)
      end
   end
end)

task.spawn(function()
   while not Unloaded do
      local speed = math.max(0.1, SETTINGS.LoopSpeedMult)
      if SETTINGS.Enabled and not Firing and isAimHeld() then
         local target = findTargetV16()
         if target and isAlive(target.Parent) then
            snapFireRestore(target)
            local cd
            local untilDeath = false
            if SETTINGS.RepeatMode == "Time" then
               if SETTINGS.FixedTimeDelay <= 0 then
                  untilDeath = true
                  cd = 0
               else
                  cd = SETTINGS.FixedTimeDelay / speed
               end
            else
               local rpm = 600
               local t = getEquippedTool()
               if t then
                  local mod = t:FindFirstChild("ACS_Settings")
                  if mod then
                     local ok, settings = pcall(require, mod)
                     if ok and type(settings) == "table" then
                        rpm = settings.ShootRate or settings.FireRate or settings.RPM or 600
                     end
                  end
               end
               cd = ((60 / rpm) * SETTINGS.CooldownMult) / speed
            end
            if untilDeath then
               while isAlive(target.Parent) and not Unloaded do task.wait(0.02) end
            elseif cd > 0 then
               local tStart = tick()
               while (tick() - tStart) < cd and not Unloaded do
                  task.wait(0.02)
                  if not isAlive(target.Parent) then break end
               end
            end
         else
            task.wait(0.1 / speed)
         end
      else
         task.wait(0.1 / speed)
      end
   end
end)

task.spawn(function()
   local lastEquippedTool = nil
   while not Unloaded do
      local tool = getEquippedTool()
      if lastEquippedTool ~= tool then
         if lastEquippedTool then restoreOriginalStats(lastEquippedTool) end
         lastEquippedTool = tool
         if tool then buildToolCache(tool) end
         if tool and (SETTINGS.ZeroRecoil or SETTINGS.ZeroSpread) then zeroStats(tool) end
      end
      task.wait(0.5)
   end
end)

