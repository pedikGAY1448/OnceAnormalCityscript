local function normalizeName(s) return tostring(s):lower():gsub("[%s_%-]", "") end

local function isAmmoName(name)
   local n = normalizeName(name)
   if AMMO_STOP_SET[n] then return false end
   return AMMO_PATTERN_SET[n] == true
end
local function isJammedName(name)
   local n = normalizeName(name)
   if JAMMED_STOP_SET[n] then return false end
   return JAMMED_SET[n] == true
end
local function isZeroName(name)
   local n = normalizeName(name)
   return ZERO_SET[n] == true
end

local function getOrCreateSettings(tool)
   if not tool then return nil end
   local mod = tool:FindFirstChild("ACS_Settings")
   if not mod then return nil end
   local ok, data = pcall(require, mod)
   if ok and type(data) == "table" then return data end
   return nil
end

local function getByPath(tbl, path)
   local parts = {}
   for p in path:gmatch("[^%.]+") do parts[#parts+1] = p end
   local cur = tbl
   for _, p in ipairs(parts) do
      if type(cur) ~= "table" then return nil, false end
      cur = cur[p]
   end
   if cur == nil then return nil, false end
   return cur, true
end

local function setByPathSafe(tbl, path, value)
   local parts = {}
   for p in path:gmatch("[^%.]+") do parts[#parts+1] = p end
   local cur = tbl
   for i = 1, #parts - 1 do
      if type(cur[parts[i]]) ~= "table" then return false end
      cur = cur[parts[i]]
   end
   local key = parts[#parts]
   if cur[key] == nil then return false end
   cur[key] = value
   return true
end

